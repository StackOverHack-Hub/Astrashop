# Public values and secret file paths for compose.aws.yaml.
# Supply an ECS task role when running the image on AWS. Do not put AWS keys here.
ASTRASHOP_IMAGE=astrashop:local
ASTRASHOP_PORT=8080
AWS_REGION=ap-south-1
ITEMS_TABLE=your-items-table
RESERVATIONS_TABLE=your-reservations-table
MARKETPLACE_TABLE=your-marketplace-table
TENANCY_TABLE=your-tenancy-table
DEFAULT_SHOP_ID=campus-shop
REDIS_HOST=your-private-cache-endpoint
REDIS_PORT=6379
REDIS_CLUSTER=true
SHOP_KEY_PATH=/absolute/path/to/shop-key.txt
REDIS_PASSWORD_PATH=/absolute/path/to/redis-password.txt
COGNITO_USER_POOL_ID=ap-south-1_yourpool
COGNITO_CLIENT_ID=your-client-id
COGNITO_LOGIN_ORIGIN=https://your-domain.auth.ap-south-1.amazoncognito.com
ALLOWED_ORIGIN=https://your-site.example
# Set to 1 only when network rules restrict traffic to your trusted ALB.
TRUST_PROXY_HOPS=0
